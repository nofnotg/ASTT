# =========================================================
# ASTT - Upbit Only Live Paper Trading MVP
# =========================================================

# App
APP_ENV=local
APP_TIMEZONE=Asia/Seoul
APP_NAME=ASTT

# Database
DATABASE_URL=sqlite:///data_store/app.sqlite

# Upbit
UPBIT_BASE_URL=https://api.upbit.com
UPBIT_WS_PUBLIC_URL=wss://api.upbit.com/websocket/v1

# Fill these manually
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_ALLOWED_IP=

# Trading Mode
# PAPER | ORDER_TEST | LIVE_DISABLED | LIVE
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
ORDER_TEST_ENABLED=true

# Virtual Account
VIRTUAL_CASH_KRW=1000000

# Risk
MAX_DAILY_LOSS_PCT=1.5
DAILY_TARGET_PCT=1.0
MIN_ORDER_KRW=5000
MAX_ORDER_KRW=10000
MAX_OPEN_POSITIONS=5

# 09:00 Strategy
KST_OPEN_SCAN_START=08:50
KST_OPEN_MONITOR_START=09:00
KST_OPEN_DECISION_TIME=09:03
KST_OPEN_TRADE_END=09:30
MAX_SCAN_MARKETS=50

# Persona Thresholds
MIN_MR_K_SCORE=50
MIN_MAGGIE_SCORE=85
MIN_REZO_SCORE=80
MIN_COSTA_SCORE=60
MIN_IRIS_SCORE=75
MIN_FINAL_SCORE=80

# CostA
ENABLE_COSTA_DCA=false
COSTA_STEP_1_KRW=10000
COSTA_STEP_2_KRW=20000
COSTA_STEP_3_KRW=30000
COSTA_TAKE_PROFIT_PCT=0.8
COSTA_MAX_EXPOSURE_PER_MARKET_KRW=60000

# Fees / Slippage
TAKER_FEE_PCT=0.05
DEFAULT_SLIPPAGE_PCT=0.15
CONSERVATIVE_FILL_MODE=true

# API Rate Limit Safety
UPBIT_QUOTATION_RPS_LIMIT=8
UPBIT_ORDER_RPS_LIMIT=4
RATE_LIMIT_BACKOFF_SECONDS=1.0

# WebSocket tick storage
STORE_RAW_TICKS=false
TICK_RETENTION_HOURS=24

# Logging
LOG_LEVEL=INFO

# Optional Telegram
ENABLE_TELEGRAM_ALERT=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM
ENABLE_LLM_DEBATE=false
LLM_PROVIDER=
OPENAI_API_KEY=
LLM_MODEL=

